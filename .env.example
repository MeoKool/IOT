# Smart Room Dashboard configuration example
# Copy to .env and edit for your laptop or Raspberry Pi.

APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=true

UPDATE_INTERVAL_SECONDS=3
CHART_MAX_POINTS=20
HISTORY_DEFAULT_PER_PAGE=20

DATABASE_PATH=smart_room.db
MOCK_MODE=true

MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=smart-room-flask-dashboard
MQTT_TOPIC_DATA=room/data
MQTT_TOPIC_LOG=room/data/log
MQTT_TOPIC_CONTROL=room/control
MQTT_USERNAME=
MQTT_PASSWORD=
